# =============================================================================
# Backend Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# ---- Django Settings ----
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- CORS ----
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Stock Data Provider ----
# Finnhub API key (get a free key at https://finnhub.io/)
# Falls back to Yahoo Finance if not set
FINNHUB_API_KEY=your_finnhub_api_key_here

# ---- Supabase (required when DEBUG=False) ----
# 1. Create a project at https://supabase.com
# 2. Get the PostgreSQL connection string from Project Settings > Database
# 3. Get the service role key from Project Settings > API
# 4. Create a public storage bucket named "avatars"
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=avatars

# ---- AI Trade Coach (OpenRouter) ----
# Get a free key at https://openrouter.ai/keys
# Free models: meta-llama/llama-4-maverick:free, google/gemma-3-1b-it:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-4-maverick:free

# ---- Filings Research Analyst ----
# SEC EDGAR requires a descriptive User-Agent identifying you.
SEC_EDGAR_USER_AGENT=Open-Papertrade Research (your-email@example.com)

# LLM provider used by the research analyst.
# One of: anthropic | openai | openrouter | mistral | ollama | local
LLM_PROVIDER=anthropic

# --- Hosted providers (pick whichever you have) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OpenRouter: one key, hundreds of models (Claude, GPT, Mistral, Llama, DeepSeek...)
# Get a key at https://openrouter.ai/keys — free tier available on some models.
OPENROUTER_API_KEY=
# Optional attribution (shows up on OpenRouter's public leaderboard):
OPENROUTER_REFERER=https://open-papertrade.local
OPENROUTER_APP_TITLE=Open-Papertrade Filings

# Mistral: https://console.mistral.ai/
MISTRAL_API_KEY=

# --- Local runners (OpenAI-compatible endpoints, no API key required) ---
# Ollama (default http://localhost:11434 — pull a model with `ollama pull llama3.1`)
OLLAMA_BASE_URL=http://localhost:11434
# LM Studio / vLLM / llama.cpp server: set this to whichever you're running.
#   LM Studio       -> http://localhost:1234/v1
#   vLLM            -> http://localhost:8000/v1
#   llama.cpp server-> http://localhost:8080/v1
LOCAL_LLM_BASE_URL=

# Embedding + chunking config (safe to leave default).
FILINGS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FILINGS_CHUNK_TOKENS=400
FILINGS_CHUNK_OVERLAP=50
